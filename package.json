{
  "name": "echofootprint",
  "version": "1.2.0",
  "description": "Privacy-first browser extension that visualizes cross-site tracking from 50 major ad network platforms with 100% local processing, no data collection, and GDPR-first privacy and security",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-extension-scripts.js && vite build && node scripts/build-helper.js",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "npm run format:check",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:ui": "vitest --ui",
    "zip": "npm run build && rm -f dist/echofootprint.zip && cd dist && zip -r echofootprint.zip .",
    "prepare": "husky",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/"
  },
  "keywords": [
    "privacy",
    "facebook",
    "tracking",
    "visualization",
    "browser-extension"
  ],
  "author": "EchoFootPrint",
  "license": "UNLICENSED",
  "dependencies": {
    "d3": "^7.9.0",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^4.2.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "canvas": "^3.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "prettier": "^3.1.1",
    "sharp": "^0.35.4",
    "vite": "^5.0.8",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
